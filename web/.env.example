# URL base de la API. En desarrollo se deja vacía para usar el proxy de Vite.
VITE_API_URL=

# En producción (Vercel) apuntá al dominio del backend Laravel:
# VITE_API_URL=https://api.ranchomontecristo.com/api

# Opcional: clave de Google Maps para el mapa embebido.
# Sin clave, el sitio usa el iframe público de OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
