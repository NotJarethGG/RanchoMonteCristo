APP_NAME="Rancho Montecristo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Costa_Rica
APP_URL=http://localhost:8000
APP_LOCALE=es

# URL del SPA (para enlaces en correos y CORS)
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos ---------------------------------------------------------
# Opción A: MySQL / MariaDB local (XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rancho_montecristo
DB_USERNAME=root
DB_PASSWORD=

# Opción B: PostgreSQL en Supabase
# Usá SIEMPRE el pooler: el host directo (db.<ref>.supabase.co) resuelve solo
# a IPv6 y falla desde redes y hostings sin IPv6. El pooler es IPv4.
# La cadena está en Supabase → Project Settings → Database → Connection pooling.
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<la contraseña de la base>
# DB_SSLMODE=require

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="reservas@ranchomontecristo.com"
MAIL_FROM_NAME="${APP_NAME}"

# Extensiones futuras (dejar vacío por ahora)
GOOGLE_MAPS_API_KEY=

# === Cloudinary (cloudinary.com → Dashboard) ===
# Sin estas variables las imágenes se guardan en el disco local, que en
# Render y similares se borra en cada redespliegue.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rancho-montecristo
