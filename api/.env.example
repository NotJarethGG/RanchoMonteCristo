APP_NAME="Rancho Monte Cristo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Costa_Rica
APP_URL=http://localhost:8000
APP_LOCALE=es

# URL del SPA (para enlaces en correos y CORS)
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rancho_montecristo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="reservas@ranchomontecristo.com"
MAIL_FROM_NAME="${APP_NAME}"

# Extensiones futuras (dejar vacío por ahora)
GOOGLE_MAPS_API_KEY=
