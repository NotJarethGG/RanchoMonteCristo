# --- Sistema
.DS_Store
Thumbs.db

# --- Dependencias y builds
node_modules/
/web/dist/
/api/vendor/

# --- Variables de entorno (nunca al repositorio)
.env
.env.*
!.env.example

# --- Laravel
# Se ignora el contenido pero se versiona un .gitkeep por carpeta: si esas
# carpetas no existieran tras un `git clone`, Laravel no arrancaría (no podría
# escribir vistas compiladas ni sesiones).
/api/storage/*.key
/api/storage/logs/*.log
/api/storage/framework/cache/data/*
!/api/storage/framework/cache/data/.gitkeep
/api/storage/framework/sessions/*
!/api/storage/framework/sessions/.gitkeep
/api/storage/framework/views/*
!/api/storage/framework/views/.gitkeep
/api/storage/framework/testing/*
!/api/storage/framework/testing/.gitkeep
/api/bootstrap/cache/*.php
/api/public/storage
/api/public/build
/api/public/hot
/api/.phpunit.result.cache
/api/.phpunit.cache

# --- Archivos subidos desde el dashboard (no son código)
/api/storage/app/public/*
!/api/storage/app/public/.gitkeep

# --- Base local de respaldo
/api/database/database.sqlite

# --- Editores
/.idea
/.vscode
